# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# ==============================================================================
# Place these variables in your production host (Vercel / Cloudflare / Coolify / VPS)
# IMPORTANT: Never commit your actual live secret keys to public git repositories!
# ==============================================================================

# 1. Your Custom Domain / Live URL
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 2. SUPABASE PRODUCTION (https://supabase.com)
# ------------------------------------------------------------------------------
# Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key
# Service role key (Keep secret! Only used by server webhook handler)
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. STRIPE PRODUCTION (LIVE MODE) (https://dashboard.stripe.com/apikeys)
# ------------------------------------------------------------------------------
# Toggle "Test mode" OFF in the Stripe Dashboard to get Live keys:
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_live_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_secret_key

# Live recurring subscription price ID (e.g., $29/month created in Live Mode)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_live_price_id

# Live Webhook Secret from: Stripe Dashboard -> Developers -> Webhooks
# Add endpoint: https://your-domain.com/api/webhooks/stripe
# Select events:
#   - checkout.session.completed
#   - customer.subscription.updated
#   - customer.subscription.deleted
# Copy Signing Secret (starts with whsec_...):
STRIPE_WEBHOOK_SECRET=whsec_your_live_webhook_signing_secret

# ------------------------------------------------------------------------------
# 4. RESEND PRODUCTION (https://resend.com/api-keys)
# ------------------------------------------------------------------------------
# Verified sending domain required on resend.com/domains
RESEND_API_KEY=re_your_production_resend_api_key
